{
  "specification": "Styx canonical JSON and deterministic CBOR (libs/Styx/Styx/Illias/JSON/README.md); WWCP POI 3 SPECIFICATION.md section 1",
  "description": "JSON text read as POI reads what it hashes (decimals as decimals, strings as strings), written as canonical JSON and as deterministic CBOR; and JSON text a reader must refuse.",
  "vectors": [
    {
      "id": "styx-4-01",
      "description": "Properties sorted, whitespace removed, decimals keep their scale; in CBOR, keys sorted by their encodings and decimals as decimal fractions.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "{ \"b\" : 1, \"a\" : [ 1.0, 1, 1.50, 100, -2, 0.10 ], \"aa\" : \"x\", \"c\" : null, \"d\" : true }",
      "expected": {
        "canonical": "{\"a\":[1.0,1,1.50,100,-2,0.10],\"aa\":\"x\",\"b\":1,\"c\":null,\"d\":true}",
        "cborHex": "a5616186c482200a01c482211896186421c482210a6162016163f66164f56261616178"
      }
    },
    {
      "id": "styx-4-02",
      "description": "Ordinal order of the names in JSON, bytewise order of their encodings in CBOR.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "{\"aa\":1,\"b\":2,\"a\":3,\"é\":4}",
      "expected": {
        "canonical": "{\"a\":3,\"aa\":1,\"b\":2,\"é\":4}",
        "cborHex": "a46161036162026261610162c3a904"
      }
    },
    {
      "id": "styx-4-03",
      "description": "Empty containers and strings.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "{\"o\":{},\"a\":[],\"s\":\"\"}",
      "expected": {
        "canonical": "{\"a\":[],\"o\":{},\"s\":\"\"}",
        "cborHex": "a3616180616fa0617360"
      }
    },
    {
      "id": "styx-4-04",
      "description": "Decimal fractions, and the largest mantissa of a decimal as a bignum.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "[22000.0, -1.5, 0.000, 79228162514264337593543950335]",
      "expected": {
        "canonical": "[22000.0,-1.5,0.000,79228162514264337593543950335]",
        "cborHex": "84c482201a00035b60c482202ec4822200c24cffffffffffffffffffffffff"
      }
    },
    {
      "id": "styx-4-05",
      "description": "Integers beyond 64 bit signed, as major types 0 and 1.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "[18446744073709551615, -9223372036854775809]",
      "expected": {
        "canonical": "[18446744073709551615,-9223372036854775809]",
        "cborHex": "821bffffffffffffffff3b8000000000000000"
      }
    },
    {
      "id": "styx-4-06",
      "description": "Exponents written out, a negative zero loses its sign.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
      "input": "[1.0, 1, 1.50, 0.000, -0.0, 100, 1e-7, 1.5e2, 1E-2]",
      "expected": {
        "canonical": "[1.0,1,1.50,0.000,0.0,100,0.0000001,150,0.01]"
      }
    },
    {
      "id": "styx-4-07",
      "description": "Strings stay strings: no reading, no point in time.",
      "source": "libs/Styx/Styx/Illias/JSON/README.md, section 4",
